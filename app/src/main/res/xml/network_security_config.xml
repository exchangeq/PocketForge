<?xml version="1.0" encoding="utf-8"?>
<!--
  默认允许明文 HTTP：手机连局域网自建模型（如 http://192.168.1.5:11434/v1）必须用到。
  公网服务请务必用 https；应用内密钥仍走 Keystore 加密，不因明文传输而落盘泄露。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
